# Environment is supplied by the host; this project does not load .env automatically.
# Default compatibility mode. Set false on the isolated commercial service after migration.
ALLOW_LEGACY_ROOMS=true
# Private policy. Fill with hashes generated outside the repository, not raw codes.
ACCESS_POLICY_JSON={}
# Both URL array and matching coturn REST shared secret are required together.
TURN_URLS=[]
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=3600

# Sales server: production always enforces licensing and rejects legacy rooms.
# NODE_ENV=production
# REQUIRE_PLAY_LICENSE=true
# PLAY_CLOUD_PROJECT_NUMBER=
# PLAY_CERTIFICATE_SHA256=base64url_of_Play_app_signing_SHA256_without_padding
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/server-only-secret-file
# TURN_PROVIDER=cloudflare
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# TURN_CREDENTIAL_TTL=32400
# Cloudflare: remove TURN_URLS and TURN_SHARED_SECRET; never mix credentials.
# Android build only: INTERCOM_SUPPORT_EMAIL=confirmed_business_email
