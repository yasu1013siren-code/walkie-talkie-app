# Environment is supplied by the host; this project does not load .env automatically.
# Default compatibility mode. Set false on the isolated commercial service after migration.
ALLOW_LEGACY_ROOMS=true
# Private policy. Fill with hashes generated outside the repository, not raw codes.
ACCESS_POLICY_JSON={}
# Both URL array and matching coturn REST shared secret are required together.
TURN_URLS=[]
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=3600
