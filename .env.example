# Hosting environment only; Node does not load this file automatically.
NODE_ENV=production
PUBLIC_ORIGIN=https://walkie-talkie-app-42l7.onrender.com
# Empty policy denies ALL joins. Never put raw invitation keys here.
ACCESS_POLICY_JSON={}
# Legacy/public rooms are unsupported; true fails startup.
ALLOW_LEGACY_ROOMS=false
# Default: STUN only. Choose ONE TURN mode when required.
TURN_PROVIDER=rest
TURN_URLS=[]
TURN_SHARED_SECRET=
TURN_CREDENTIAL_TTL=3600
# Cloudflare mode: remove TURN_URLS and TURN_SHARED_SECRET entirely.
# TURN_PROVIDER=cloudflare
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# TURN_CREDENTIAL_TTL=32400
